@startuml upload_file_seq
title Upload File Sequence

actor "User" as user
participant "API Gateway" as gate
participant "Auth Service" as auth
participant "Metadata Service" as metadata
queue "Kafka" as kafka
participant "PostgreSQL" as db
participant "MinIO" as s3

user -> gate: POST /files/init (filename, size, contentType)
gate -> auth: validate JWT
auth --> gate: OK
gate -> metadata: request presigned URL
metadata -> db: INSERT metadata (status='PENDING')
metadata -> metadata: generate presignedURL(bucket, key)
metadata --> gate: metadata + presignedURL
gate --> user: metadata + presignedURL
|||
user -> s3: PUT {uploadUrl}
s3 --> user: 200 OK
|||
user -> gate: POST /files/complete/{fileId}
gate -> auth: validate JWT
auth --> gate: OK
gate -> kafka: publish FileUploadCompletionRequested(fileId, userId, traceId)
gate --> user: 202 Accepted + statusUrl
|||
kafka -> metadata: consume completion request event
metadata -> metadata: check object exists in MinIO (retry)
alt object found
  metadata -> db: UPDATE files SET status='UPLOADED'
else object not found after retries
  metadata -> db: UPDATE files SET status='FAILED'
end
metadata --> kafka: ack processing (offset commit)
|||
group Optional: MinIO event-driven auto-complete
  s3 -> kafka: publish ObjectCreated event
  kafka -> metadata: consume MinIO object event
  metadata -> db: confirm pending file by bucket+s3Key
end
|||
user -> gate: GET /files/{fileId}/status (poll)
gate -> metadata: GET /files/{fileId}/status
metadata --> gate: status=PENDING|UPLOADED|FAILED
gate --> user: status response
|||
@enduml